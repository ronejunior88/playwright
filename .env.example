# Copie este arquivo para .env apenas quando precisar trocar os padroes.
# O .env e ignorado pelo Git e nao deve conter segredos reais.

# URL base da API (padrao: https://serverest.dev)
SERVE_REST_BASE_URL=https://serverest.dev

# Timeout por teste, em milissegundos (padrao: 30000; maximo: 120000)
API_TIMEOUT_MS=30000
