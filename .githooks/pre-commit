#!/usr/bin/env bash
# Pre-commit hook - bloqueia commit se validações falharem
# Executa dentro do Docker

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

echo "[pre-commit] Iniciando validação local via Docker..."
bash scripts/validar-local.sh --stage pre-commit
EXIT_CODE=$?

if [ $EXIT_CODE -ne 0 ]; then
  echo "[pre-commit] BLOQUEADO: Validações falharam (código $EXIT_CODE)" >&2
  echo "[pre-commit] Corrija os erros antes de commitar." >&2
  exit $EXIT_CODE
fi

echo "[pre-commit] Validações OK - commit permitido"
exit 0
