  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:criticos": "playwright test --grep @critico",
    "test:paralelo": "playwright test --workers=2",
    "test:latencia": "playwright test --config=playwright.latencia.config.ts",
