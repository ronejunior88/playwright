    "test:contratos:api": "playwright test tests/contratos/contratos-api.spec.ts",
    "test:impacto": "playwright test tests/impacto",
    "impacto": "node scripts/selecionar-testes.js",
    "test:mutacao": "stryker run",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
