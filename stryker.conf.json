{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx playwright test tests/contratos/schema.spec.ts tests/contratos/contratos.spec.ts tests/helpers/resposta.spec.ts tests/helpers/diagnostico.sanitizer.spec.ts tests/helpers/latencia.spec.ts --reporter=line --workers=1"
  },
  "coverageAnalysis": "off",
  "tsconfigFile": "tsconfig.stryker-ausente.json",
  "mutate": [
    "contracts/schema.ts",
    "contracts/index.ts",
    "tests/helpers/resposta.ts",
    "tests/helpers/diagnostico.ts",
    "tests/helpers/latencia.ts"
  ],
  "reporters": ["clear-text", "json"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 0
  },
  "timeoutMS": 120000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp"
}
